---
import { categoryLabels, type ProjectItem } from '@/data/projects';
import { withBase } from '@/utils/paths';

interface Props {
  project: ProjectItem;
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<a
  class="card project-card interactive-surface group flex h-full flex-col p-5"
  href={withBase(`/projects/${project.slug}/`)}
  data-interactive-surface
  aria-label={`查看项目：${project.title}`}
>
  <span class="project-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <div class="relative z-10 flex h-full flex-col">
    <div class="flex flex-wrap items-center gap-2">
      <span class="tag">{categoryLabels[project.category]}</span>
      <span class="tag project-card__status"><span class="status-dot" aria-hidden="true"></span>{project.status}</span>
    </div>
    <h3 class="mt-5 text-xl font-bold leading-tight text-ink-950">{project.title}</h3>
    <p class="mt-1 text-sm font-medium text-ink-600">{project.subtitle}</p>
    <p class="mt-4 flex-1 text-sm text-ink-600">{project.summary}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {project.tags.slice(0, 4).map((tag) => <span class="rounded-full bg-ink-50 px-2.5 py-1 text-xs font-semibold text-ink-600">{tag}</span>)}
    </div>
    <span class="project-card__action mt-6 text-sm font-bold text-accent-600">查看案例 <span aria-hidden="true">→</span></span>
  </div>
</a>

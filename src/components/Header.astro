---
import { siteConfig } from '@/config/site';
import { withBase } from '@/utils/paths';

const pathname = Astro.url.pathname;
const homeHref = withBase('/');
---

<header class="sticky top-0 z-50 border-b border-black/5 bg-white/90 backdrop-blur-xl">
  <nav class="page-shell flex h-16 items-center justify-between gap-6" aria-label="主导航">
    <a href={withBase('/')} class="flex items-center gap-2 font-semibold" aria-label="LFY 首页">
      <span class="grid h-9 w-9 place-items-center overflow-hidden rounded-full border border-black/10 bg-white shadow-line">
        <img src={siteConfig.assets.avatar} alt={`${siteConfig.brand.chineseName}头像`} class="h-full w-full object-cover" />
      </span>
      <span class="hidden text-sm text-ink-800 sm:inline">{siteConfig.brand.chineseName}</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        siteConfig.nav.map((item) => {
          const active = item.href === homeHref ? pathname === homeHref : pathname.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'rounded-full px-3 py-2 text-sm font-medium transition hover:bg-ink-100',
                active ? 'text-ink-950' : 'text-ink-600'
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>

    <a href={withBase('/contact/')} class="button button-primary hidden min-h-10 px-4 text-sm sm:inline-flex">联系我</a>

    <details class="relative md:hidden">
      <summary class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full border border-black/10 bg-white text-xl text-ink-950" aria-label="打开导航菜单">
        <span class="sr-only">打开导航</span>
        <span aria-hidden="true">☰</span>
      </summary>
      <div class="absolute right-0 mt-3 w-48 rounded-lg border border-black/10 bg-white p-2 shadow-soft">
        {
          siteConfig.nav.map((item) => (
            <a href={item.href} class="block min-h-11 rounded-md px-3 py-2.5 text-sm font-medium text-ink-700 hover:bg-ink-50">
              {item.label}
            </a>
          ))
        }
      </div>
    </details>
  </nav>
</header>

---
import { siteConfig } from '@/config/site';

interface Props {
  size?: 'large' | 'small';
}

const { size = 'large' } = Astro.props;
const sizeClass = size === 'large' ? 'h-40 w-40 text-4xl md:h-52 md:w-52 md:text-5xl' : 'h-16 w-16 text-lg';
---

<div class:list={['relative grid shrink-0 place-items-center overflow-hidden rounded-full border border-black/10 bg-white shadow-soft', sizeClass]}>
  <div class="absolute inset-2 grid place-items-center rounded-full bg-gradient-to-br from-ink-950 via-ink-800 to-accent-600 text-white">
    <span class="font-bold">LFY</span>
  </div>
  <img
    src={siteConfig.assets.avatar}
    alt={`${siteConfig.brand.chineseName} 卡通头像`}
    class="relative z-10 h-full w-full object-cover"
    loading="eager"
    onerror="this.style.display='none'"
  />
</div>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/utils/paths';
---

<BaseLayout title="页面未找到" description="LFY Portfolio 404 页面。">
  <section class="page-shell grid min-h-[60vh] place-items-center py-16 text-center">
    <div>
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl font-bold">页面未找到</h1>
      <p class="mt-4 text-ink-600">这个页面可能还在准备中，或者路径已经改变。</p>
      <a class="button button-primary mt-8" href={withBase('/')}>返回首页</a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { categoryLabels, projects, type ProjectItem } from '@/data/projects';
import { withBase } from '@/utils/paths';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props as { project: ProjectItem };

const sections = [
  ['项目概况', project.summary],
  ['背景与问题', `${project.subtitle}。此案例优先呈现可公开的设计目标、规则结构和流程表达，避免展示内部后台、配置表和敏感数据。`],
  ['我的职责', project.role],
  ['设计目标', `围绕 ${project.tags.slice(0, 3).join('、')} 等方向，梳理玩家体验、系统边界和研发可执行的规则说明。`],
  ['核心方案', project.highlights.join('；')],
  ['设计流程和状态逻辑', project.pdfUrl ? '完整流程、状态逻辑和页面说明请查看下方 PDF 预览。后续可继续抽取为网页内表格和流程图。' : '后续可补充自制流程图、状态表或公开可描述的逻辑说明。'],
  ['关键决策及取舍', '在不展示内部数据和敏感配置的前提下，优先呈现规则边界、异常状态和用户体验取舍。'],
  ['上线情况与验证材料', project.verification],
  ['个人复盘', '后续可继续补充更具体的复盘内容，包括需求拆解方式、跨职能沟通、文档表达和可改进点。']
];
---

<BaseLayout title={project.title} description={project.summary}>
  <article class="page-shell py-12 md:py-16">
    <a class="text-sm font-bold text-accent-600" href={withBase('/projects/')}>返回作品集</a>
    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_320px]">
      <header>
        <div class="flex flex-wrap gap-2">
          <span class="tag">{categoryLabels[project.category]}</span>
          <span class="tag">{project.status}</span>
        </div>
        <h1 class="mt-5 max-w-4xl text-3xl font-bold leading-tight text-ink-950 sm:text-4xl md:text-6xl">{project.title}</h1>
        <p class="mt-4 text-lg text-ink-600 sm:text-xl">{project.subtitle}</p>
      </header>

      <aside class="h-fit rounded-lg border border-black/10 bg-white/70 p-5">
        <h2 class="text-sm font-bold text-ink-950">项目标签</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {project.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <div class="mt-5 flex flex-col gap-2">
          {project.pdfUrl && <a class="button button-secondary" href={project.pdfUrl} target="_blank" rel="noreferrer">打开 PDF</a>}
          {project.externalUrl && <a class="button button-primary" href={project.externalUrl} target="_blank" rel="noreferrer">{project.externalLabel ?? '外部链接'}</a>}
        </div>
      </aside>
    </div>

    {
      project.pdfUrl && (
        <section class="mt-10 rounded-lg border border-black/10 bg-white/75 p-3 sm:mt-12 sm:p-4">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="eyebrow">PDF Preview</p>
              <h2 class="mt-2 text-2xl font-bold">作品 PDF 预览</h2>
            </div>
            <a class="button button-secondary w-full sm:w-auto" href={project.pdfUrl} target="_blank" rel="noreferrer">新窗口打开</a>
          </div>
          {project.previewImage && (
            <a class="block overflow-hidden rounded-md border border-black/10 bg-white md:hidden" href={project.pdfUrl} target="_blank" rel="noreferrer">
              <img src={project.previewImage} alt={`${project.title} PDF 首页预览`} class="w-full object-contain" loading="lazy" />
            </a>
          )}
          <iframe
            src={project.pdfUrl}
            title={`${project.title} PDF 预览`}
            class="hidden h-[78vh] w-full rounded-md border border-black/10 bg-white md:block"
            loading="lazy"
          ></iframe>
        </section>
      )
    }

    <div class="mt-12 grid gap-4">
      {
        sections.map(([title, body]) => (
          <section class="rounded-lg border border-black/10 bg-white/75 p-4 sm:p-5">
            <h2 class="text-xl font-bold">{title}</h2>
            <p class="mt-3 text-ink-600">{body}</p>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>

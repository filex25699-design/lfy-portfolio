---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { contactItems } from '@/data/contact';

const contactTitle: Record<string, string> = {
  email: '邮箱联系',
  wechat: '微信二维码',
  douyin: '抖音二维码',
  social: '社交平台'
};
---

<BaseLayout title="联系我" description="LFY 的联系方式与社交链接。">
  <section class="page-shell py-12 md:py-16">
    <p class="eyebrow">Contact</p>
    <h1 class="section-title mt-3">联系我</h1>
    <p class="mt-5 max-w-3xl text-base text-ink-600 sm:text-lg">
      这里集中管理可公开联系方式。二维码、账号和新平台入口都通过数据配置维护，后续替换图片或新增页面时不需要改多个组件。
    </p>
  </section>

  <section class="page-shell grid gap-4 pb-10 md:grid-cols-3">
    {
      contactItems.map((item) => (
        <article class="card flex flex-col p-4 sm:p-5 md:min-h-72">
          <span class="tag">{contactTitle[item.type]}</span>
          <h2 class="mt-5 text-xl font-bold">{item.label}</h2>
          <p class="mt-2 break-all text-sm font-semibold text-ink-700">{item.value}</p>
          <p class="mt-3 text-sm text-ink-600">{item.description}</p>
          {item.qrImage && (
            <div class="mt-5 flex aspect-square items-center justify-center rounded-lg border border-black/10 bg-white p-3 sm:p-4">
              <img
                src={item.qrImage}
                alt={`${item.label}二维码`}
                class="max-h-56 w-full max-w-56 rounded-md object-contain sm:max-h-64 sm:max-w-64"
                loading="lazy"
                onerror="this.closest('div').style.display='none'"
              />
            </div>
          )}
          {item.href && (
            <a class="button button-primary mt-6 md:mt-auto" href={item.href}>
              发送邮件
            </a>
          )}
        </article>
      ))
    }
  </section>

  <section class="page-shell grid gap-4 pb-16 md:grid-cols-2">
    <a class="card p-5" href={siteConfig.links.googlePlay} target="_blank" rel="noreferrer">
      <span class="tag">Google Play</span>
      <h2 class="mt-5 text-xl font-bold">Love Waits: Tiles & Makeover</h2>
      <p class="mt-3 text-sm text-ink-600">公开商店页面，用于验证参与项目为已上线商业游戏。</p>
    </a>
    <div class="card p-5">
      <span class="tag">后续扩展</span>
      <h2 class="mt-5 text-xl font-bold">更多社交链接与新页面入口</h2>
      <p class="mt-3 text-sm text-ink-600">新增微信号、抖音主页、B 站、小红书、作品下载页等内容时，优先添加到配置与数据文件中统一维护。</p>
    </div>
  </section>
</BaseLayout>
